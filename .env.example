# ============================================================================
# CONFIGURAÇÃO — copie para .env.local e preencha
# ============================================================================

# OBRIGATÓRIO — link do checkout da Hotmart.
# É o único lugar do projeto onde esse link existe.
# Já confirmado com o cliente — se quiser trocar por outro produto/oferta,
# só editar aqui (o fallback em lib/site.ts usa o mesmo valor).
NEXT_PUBLIC_HOTMART_CHECKOUT_URL=https://pay.hotmart.com/E107360174P

# Opcional — código de rastreio nativo da Hotmart (aparece como ?sck=)
NEXT_PUBLIC_HOTMART_SCK=

# Opcional — Google Analytics 4 (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Opcional — Meta Pixel (apenas números)
NEXT_PUBLIC_META_PIXEL_ID=
